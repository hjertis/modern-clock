# ==============================================================================
# Digital Grandfather Clock — Environment Configuration
# ==============================================================================

# HTTP & WebSocket server listen port
PORT=8088

# Comma-separated CORS & WebSocket Origin allowlist (leave empty for same-origin only)
ALLOWED_ORIGINS=

# Optional Bearer token for POST /api/notify, POST /api/config, and authenticated WS register_themes
API_TOKEN=

# MQTT Broker connection settings
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_PREFIX=grandfather_clock

# Rust structured logging filter
RUST_LOG=grandfather_clock_backend=info,tower_http=info
