FROM rust:slim-bookworm

# Install system dependencies (curl and pkg-config for builds if needed)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install cargo-binstall and use it to install cargo-watch rapidly (pre-built binary)
RUN curl -L --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash \
    && cargo binstall -y cargo-watch

WORKDIR /app

# Expose backend REST and WebSocket port
EXPOSE 8088

# Run cargo-watch for sub-2-second hot-reloads
CMD ["cargo-watch", "-x", "run"]

